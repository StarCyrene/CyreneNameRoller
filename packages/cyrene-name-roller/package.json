{
  "packageManager": "bun@1.3.14",
  
  "name": "@starcyrene/cyrene-name-roller",
  "version": "1.4.0",
  "description": "CyreneNameRoller plugin SDK and CNRP package tool",
  "type": "module",
  "main": "./src/plugin-sdk.mjs",
  "types": "./src/plugin-sdk.d.ts",
  "exports": {
    ".": {
      "types": "./src/plugin-sdk.d.ts",
      "import": "./src/plugin-sdk.mjs",
      "default": "./src/plugin-sdk.mjs"
    },
    "./plugin-sdk": {
      "types": "./src/plugin-sdk.d.ts",
      "import": "./src/plugin-sdk.mjs",
      "default": "./src/plugin-sdk.mjs"
    }
  },
  "bin": {
    "cnrp": "bin/cnrp.mjs"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "pack": "node ./bin/cnrp.mjs pack"
  },
  "keywords": ["cyrene", "name-roller", "plugin", "cnrp"],
  "author": "Cyrene2008",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StarCyrene/CyreneNameRoller.git",
    "directory": "packages/cyrene-name-roller"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "esbuild": "^0.25.12",
    "javascript-obfuscator": "^5.5.0",
    "jszip": "^3.10.1"
  }
}

