{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Cyreneの随机点名器",
  "version": "26.2.2",
  "identifier": "cn.cyrene2008.nameroller",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cyreneの随机点名器",
        "width": 1200,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "backgroundColor": "#fdf5fa"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    },
    "license": "GPL-3.0",
    "licenseFile": "LICENSE"
  }
}
